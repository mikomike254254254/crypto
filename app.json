{
  "expo": {
    "name": "Wallex Online",
    "slug": "wallex-online",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wallex-logo.png",
    "scheme": "wallex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "online.wallex.app",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/wallex-logo.png",
        "backgroundColor": "#000000"
      }
    },
    "splash": {
      "image": "./assets/images/wallex-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/wallex-logo.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
